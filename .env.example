# Existing optional portfolio integrations
GITHUB_TOKEN=
COUNTAPI_TOKEN=
COUNTAPI_BASE=
COUNTER_SLUG=

# Generic PostgreSQL connection strings. Keep both values server-side.
# Use a direct URL for schema migrations; prefer the provider's pooled URL for runtime queries.
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL_POOLED=postgresql://<user>:<password>@<pool-host>/<database>?sslmode=require

# Better Auth: generate with `openssl rand -base64 48`
AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated addresses allowed to manage the blog (independent of reader accounts)
ADMIN_EMAILS=admin@example.com

# Configure your production Better Auth URL and any other accepted browser origins.
# The URL uses the origin only; Better Auth itself is mounted under /api/auth.
# BETTER_AUTH_URL=https://your-domain.example
# Comma-separated additional origins, e.g. local dev plus production.
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,https://your-domain.example
# Optional comma-separated hostnames whose incoming host may be used for OAuth callbacks.
# Leave unset to always use BETTER_AUTH_URL; do not include schemes or paths.
# BETTER_AUTH_ALLOWED_HOSTS=your-domain.example,preview.your-domain.example

# Optional OAuth providers for reader/admin sign-in. Configure callbacks at:
# Google/GitHub: https://your-domain.example/api/auth/callback/{google|github}
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional generic OIDC provider: discovery URL, client ID, and provider identifier.
CUSTOM_OIDC_PROVIDER_ID=
CUSTOM_OIDC_PROVIDER_NAME=
CUSTOM_OIDC_DISCOVERY_URL=
CUSTOM_OIDC_CLIENT_ID=
CUSTOM_OIDC_CLIENT_SECRET=
CUSTOM_OIDC_SCOPES=openid email profile

# Optional Better Auth Dash telemetry key. Leave blank until a valid key is available.
BETTER_AUTH_API_KEY=