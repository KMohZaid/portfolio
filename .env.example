# Existing optional portfolio integrations
GITHUB_TOKEN=
COUNTAPI_TOKEN=
COUNTAPI_BASE=
COUNTER_SLUG=

# MongoDB Atlas or another MongoDB deployment
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB=portfolio

# Authentication: generate with `openssl rand -base64 48`
AUTH_SECRET=
# Comma-separated addresses allowed to manage the blog
ADMIN_EMAILS=you@example.com

# Verified Resend sender for passwordless email sign-in
RESEND_API_KEY=
AUTH_FROM_EMAIL=Portfolio Admin <admin@example.com>
NEXT_PUBLIC_SITE_URL=http://localhost:3000
