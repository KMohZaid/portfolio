# Optional portfolio integrations

# Optional GitHub API token for portfolio widgets. Requests can work without a token, but GitHub
# applies lower rate limits to unauthenticated requests. Use a least-privilege token and keep it
# server-side; never add a NEXT_PUBLIC_ prefix.
GITHUB_TOKEN=

# Optional external likes-counter integration. Leave all three blank to disable it.
# COUNTAPI_BASE and COUNTER_SLUG identify the CountAPI-compatible service and counter.
# COUNTAPI_TOKEN is optional unless your counter service requires bearer-token authentication.
COUNTAPI_BASE=
COUNTER_SLUG=
COUNTAPI_TOKEN=

# PostgreSQL configuration for blog, accounts, admin publishing, uploads metadata, and purchases.
# The portfolio can run without a database, but those persistent features will not be available and
# the public blog falls back to bundled read-only sample posts.
# A free provider such as Neon may be sufficient for light portfolio blogging; check its current
# free-tier limits, sleep/compute behavior, SSL requirements, and connection guidance.
# Required when enabling database-backed blog/auth features. Use the DIRECT connection URL for
# applying SQL migrations and seeding. Runtime also uses this URL if no pooled URL is configured.
# Keep credentials private; do not commit a populated URL.
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# Optional pooled PostgreSQL URL. When set, the application prefers this for runtime queries and
# Better Auth. Many hosted platforms recommend a pooler for serverless or short-lived instances.
# This does not replace the direct DATABASE_URL needed for migrations/seeding.
DATABASE_URL_POOLED=postgresql://<user>:<password>@<pool-host>/<database>?sslmode=require

# Better Auth configuration

# Required in production. Stable signing/encryption secret, at least 32 characters.
# Generate a strong value with: openssl rand -base64 48
# Keep unchanged across restarts and store only in the server's environment.
AUTH_SECRET=

# Set this to the canonical site origin when deploying (HTTPS in production), with no /api/auth
# suffix. Local development defaults to http://localhost:3000. Needed for reliable OAuth callbacks.
BETTER_AUTH_URL=http://localhost:3000

# Optional comma-separated browser origins trusted to initiate authentication. Usually the canonical
# site origin plus explicitly used local/preview origins. Do not put callback paths here.
# If unset, the configured Better Auth URL is used as the default trusted origin.
# BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,https://your-domain.example

# Optional legacy fallback for BETTER_AUTH_URL. Prefer BETTER_AUTH_URL for new setups; only set this
# if an existing hosting configuration still relies on APP_URL.
# APP_URL=http://localhost:3000

# Optional comma-separated hostnames (host[:port], no scheme or path) that Better Auth may accept
# when forming OAuth callbacks. Leave unset unless multiple trusted public hosts are required.
# BETTER_AUTH_ALLOWED_HOSTS=your-domain.example,preview.your-domain.example

# Optional comma-separated list of VERIFIED account email addresses allowed to administer the blog.
# Reader sign-in does not require an address here. Set at least one address if you need admin access;
# use your own address locally and do not commit personal addresses.
ADMIN_EMAILS=admin@example.com

# OAuth sign-in providers. Each is optional, but configure at least one complete provider pair if
# users need to sign in. Register the corresponding callback URL with the provider, replacing the
# example host with your own canonical public domain:
#   https://your-domain.example/api/auth/callback/google
#   https://your-domain.example/api/auth/callback/github
# Keep client secrets server-side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional generic OpenID Connect provider. Set PROVIDER_ID, DISCOVERY_URL, and CLIENT_ID together
# to enable it. NAME is a display label and defaults to PROVIDER_ID. CLIENT_SECRET is only needed if
# required by the provider. SCOPES defaults to "openid email profile" and is space-separated.
CUSTOM_OIDC_PROVIDER_ID=
CUSTOM_OIDC_PROVIDER_NAME=
CUSTOM_OIDC_DISCOVERY_URL=
CUSTOM_OIDC_CLIENT_ID=
CUSTOM_OIDC_CLIENT_SECRET=
CUSTOM_OIDC_SCOPES=openid email profile

# Optional Better Auth Dash telemetry key. Leave blank if telemetry is not used; authentication and
# PostgreSQL-backed sessions do not depend on it. Keep any configured key server-side.
BETTER_AUTH_API_KEY=

# Optional Telegram media/file storage for admin uploads. Set BOTH variables to enable uploads and
# delivery. TELEGRAM_BOT_TOKEN is a secret from BotFather; TELEGRAM_UPLOAD_CHAT_ID identifies the
# private storage chat. Never expose the token to the browser or commit real values. Current upload
# limit is 20 MB per file.
TELEGRAM_BOT_TOKEN=
TELEGRAM_UPLOAD_CHAT_ID=

# Optional Razorpay payments. Set BOTH credentials to enable paid-article checkout. Use matching
# Test Mode credentials (Key IDs start with rzp_test_) while testing; Live Mode can charge real
# money. Keep the key secret server-side and never expose either value in client code.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional but recommended webhook signing secret for asynchronous Razorpay payment confirmation.
# In the matching Razorpay Test or Live dashboard, register your environment's public HTTPS URL
# ending in /api/payments/webhook and subscribe to payment.captured. Choose a strong webhook secret
# in Razorpay and put the same value here. This is DIFFERENT from RAZORPAY_KEY_SECRET. If blank,
# browser verification and payment reconciliation remain available, but webhook fallback is off.
# Keep this value server-side and never commit it.
RAZORPAY_WEBHOOK_SECRET=
