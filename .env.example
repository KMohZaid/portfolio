# Existing optional portfolio integrations
GITHUB_TOKEN=
COUNTAPI_TOKEN=
COUNTAPI_BASE=
COUNTER_SLUG=

# Supabase project URL and server-only secret/service-role key.
# Find these in Supabase: Project Settings > API. Never use NEXT_PUBLIC_ for the secret key.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Never-used server-side publishable key for optional public client access. Not needed by this app.
# SUPABASE_PUBLISHABLE_KEY=

# Authentication: generate with `openssl rand -base64 48`
AUTH_SECRET=
# Comma-separated addresses allowed to manage the blog
ADMIN_EMAILS=mzaidkapadia+portfolio@gmail.com

# Verified Resend sender for passwordless email sign-in
RESEND_API_KEY=
AUTH_FROM_EMAIL=Portfolio Admin <admin@example.com>
# Optional canonical origin for email URLs. If unset, request host must be in TRUSTED_HOSTS.
# In production, use HTTPS. Server-only; never NEXT_PUBLIC_.
# APP_URL=https://your-deployment.example
# Comma-separated trusted host[:port] values when APP_URL is unset. Configure actual production hosts.
TRUSTED_HOSTS=localhost:3000,127.0.0.1:3000
